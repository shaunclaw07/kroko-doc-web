        {
          "resource": "repo://src/infrastructure/storage/httpRemoteLog.ts#L23-L44",
          "version": "repo-lines-v1:sha256:afe1812c2d2f60a36e753c1539a7e13edbe1879a1d6cbfa9064a3c17558a6f8a:"
