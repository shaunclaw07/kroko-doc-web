  "claims": [
    {
      "id": "claim_b12bf10667c14425a3bb19aa2808d57d",
      "statement": "Der Austauschvertrag des Rundenprotokolls gehört dem Kern: `RoundRecord` und `CSV_HEADER` werden aus `src/core/domain/records.ts` exportiert und von `src/contract/sessionLog.ts` unverändert weitergereicht, sodass die Bedienung das Format nicht nachbaut.",
      "evidence": [
        {
          "resource": "repo://src/contract/sessionLog.ts#L1-L6",
          "version": "repo-lines-v1:sha256:798639424f417dd5b35df5457bb7a7d528645e5ec7984ee86ab006925087cbdd:"
        },
        {
          "resource": "repo://src/core/domain/records.ts#L1-L26",
          "version": "repo-lines-v1:sha256:55c9a8e4e45410ebeb4c23b6a15e19767eeb4efcd9cf203a346d57b3390f2273:"
        }
      ]
    },
    {
      "id": "claim_9c99ea5f94874aa4b25e71e9ba0835d5",
      "statement": "`RoundRecord` trägt elf Felder in dieser Bedeutung: `round` (laufende Nummer ab 1, nur für den Austausch), `playedAt` (ISO 8601), `creature` (Katalogkennung), `teeth`, `mode`, `players`, `loserTooth` (1-basiert, innerhalb `1..teeth`), `pressIndex` (1-basiert), `liveCount` und `pressOrder` (readonly, alle Drücke in Reihenfolge); `createRoundRecord` kopiert `pressOrder` und setzt `creature` auf `DEFAULT_CREATURE_ID`, wenn keins übergeben wird.",
      "evidence": [
        {
          "resource": "repo://src/core/domain/records.ts#L3-L22",
          "version": "repo-lines-v1:sha256:403a437f2a0761ef4653ec24169910f3297eb25fe7f9f4307f5b88dca9b06264:"
        },
        {
          "resource": "repo://src/core/domain/sessionLog.ts#L206-L224",
          "version": "repo-lines-v1:sha256:1bda0653e93b1b203c7b1a19705a9b885f9e660a609634e294eba560eba209b6:"
        }
      ]
    },
    {
      "id": "claim_2e3d4eccb52f43629edcb145a5974e25",
      "statement": "`CSV_HEADER` legt zehn `;`-getrennte Spalten fest (`runde;reihenfolge;verlierer_zahn;modus;zaehne;spieler;druck_nummer;scharfe_zaehne;lebewesen;zeitpunkt`); die ersten drei sind absichtlich identisch mit dem Format des Analyse-Werkzeugs, damit Dateien in beide Richtungen austauschbar bleiben.",
      "evidence": [
        {
          "resource": "repo://src/core/domain/records.ts#L24-L26",
          "version": "repo-lines-v1:sha256:be44ffbe972649735922dc2df82b2e8ba419529afc7ac2620f9d63e80aaa5bf1:"
