    {
      "id": "claim_dbe1b417670740288e5677bb6442ffa8",
      "statement": "Der CSV-Import der Statistikseite hängt die gelesenen Runden an das vorhandene Protokoll an und nummeriert sie fortlaufend ab der größten vorhandenen Nummer neu; bei null gültigen Zeilen meldet die Seite „Keine gültigen Zeilen gefunden.\" und schreibt nichts, nach erfolgreichem Import wird die Sicherung abgeglichen.",
      "evidence": [
        {
          "resource": "repo://src/presentation/stats/statsPage.test.ts#L84-L111",
          "version": "repo-lines-v1:sha256:a27bd9b9e1e8bc22276f24b32279df47e5c17e59ed040597d7e0693a68bcb4bb:"
        },
