        }
      ]
    },
    {
      "id": "claim_9967f69e5acc4022b5e48c26bb0bfe7c",
      "statement": "Fehlende oder unlesbare Werte ersetzt `fromCsv` durch Spielstandards statt sie zu raten: `teeth` → `DEFAULT_TEETH` (10, weil das Kurzformat die Zahnzahl nicht kennt), `mode` → `DEFAULT_MODE`, `players` → 1, `liveCount` → 0, `round` → Zeilennummer + 1, `pressIndex` → aus der Position des Verlierer-Zahns in `pressOrder`, `creature` → Krokodil bei unbekannter Kennung.",
      "evidence": [
        {
          "resource": "repo://src/core/domain/sessionLog.test.ts#L44-L71",
          "version": "repo-lines-v1:sha256:d3af0a8a451f2c97ed541d4f79d59aed1cad5e00216d38b8aea348e0624f7e65:"
