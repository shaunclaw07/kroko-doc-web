    {
      "id": "claim_e12379cfba094b54bf2d645e37b7dd1f",
      "statement": "`isPlausibleRecord` verlangt: `round` ganzzahlig ≥ 1, `teeth` nach `isValidToothCount` (1..`MAX_TEETH` = 12), `loserTooth` und `pressIndex` ganzzahlig innerhalb `1..teeth`, `mode` in `RANDOM_MODES`, `players` nach `isValidPlayerCount` (1..`MAX_PLAYERS` = 4), `liveCount` ganzzahlig 0..`MAX_LIVE_TEETH` = 3, `pressOrder` als Array mit allen Einträgen innerhalb `1..teeth` sowie `creature` als `undefined` oder String.",
      "evidence": [
        {
          "resource": "repo://src/core/domain/sessionLog.ts#L102-L130",
          "version": "repo-lines-v1:sha256:99a07a20293dde9c2e071a3af56d815e6192b6bbc89edfc00bf418fea0689f78:"
