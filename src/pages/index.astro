---
import Base from '../layouts/Base.astro';
import { DEFAULT_CREATURE_ID, listCreatures } from '../core/domain/creature';
import { creaturePortrait } from '../presentation/game/creatures';

const creatures = listCreatures();
const first = creatures.find((creature) => creature.id === DEFAULT_CREATURE_ID) ?? creatures[0];
const base = import.meta.env.BASE_URL;
---

<Base
  title="Zahn Agent — Zahn für Zahn zum Nervenkitzel"
  description="Tippe die Zähne des Krokodils an. Ein Druck ist zu viel — dann schnappt das Maul zu. Mit Statistik, wer wirklich verliert."
>
  <!--
    Das Spiel kommt zuerst: Tier und Spielstand. Was je Runde wechselt (Tier, Zähne, „Neue Runde")
    steht als große Griffe auf der Seite; hinter dem Zahnrad liegt nur, was je Sitzung gestellt
    wird. Die zwei benannten Anzeigewerte (Fortschritt und Bissgefahr) bleiben wörtlich stehen —
    sie tragen die Ehrlichkeitsregel.
  -->
  <main class="app">
    <header class="topbar">
      <div class="brand">
        <!-- Dasselbe Zeichen wie Tab und Startbildschirm (public/logo.svg, erzeugt in
             src/icon.test.ts aus der eigenen Zeichnung des Krokodils, Maul zu). -->
        <img
          class="brand__mark"
          src={`${import.meta.env.BASE_URL}logo.svg`}
          alt=""
          aria-hidden="true"
          width="34"
          height="34"
        />
        <span>Zahn Agent</span>
      </div>
      <span class="round-tag">Runde <strong id="hud-round">1</strong></span>
      <button type="button" class="icon-button" id="settings-open" aria-haspopup="dialog" aria-label="Einstellungen öffnen">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6"></path>
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1"></path>
        </svg>
      </button>
    </header>

    <!-- Das Spielfeld: Bühne und Spielstand. Auf dem Tablet quer ist das die linke Spalte. -->
    <div class="play">
      <section class="stage" id="stage" data-status="open" aria-label="Spielbühne">
        <div id="croc-mount"></div>
        <!-- Ansage eines neuen Sterns (Tier-Album). Liegt ÜBER der Bühne und ändert keine Maße;
             sichtbar nur, solange das Maul zu ist (CSS an `data-status`). Fängt keinen Tipp ab. -->
        <p class="star-toast hidden" id="star-toast" role="status"></p>
      </section>

      <!-- Eine große Aussage, daneben wer dran ist. -->
      <section class="hud" id="hud-stats" aria-label="Spielstand">
        <div class="stat stat--big">
          <span class="stat__value" id="hud-remaining">10</span>
          <span class="stat__label" id="hud-remaining-label">Zähne übrig</span>
        </div>
        <div class="turn">
          <span class="turn__dot" aria-hidden="true"></span>
          <span id="hud-turn">Du bist dran</span>
        </div>
      </section>

      <!-- Das Ergebnis der Runde steht auf der Seite, an der Stelle des Spielstands, und
           verschwindet mit der neuen Runde. Bis zum 12.10.2026 war es ein modales Blatt: seit
           „Neue Runde" immer in der Leiste steht, hielt es nur noch auf. -->
      <section class="result hidden" id="result-panel" role="status" aria-labelledby="result-title">
        <h2 id="result-title">Zugeschnappt!</h2>
        <p id="result-text"></p>
        <!-- Ein Satz über das echte Tier (Katalogfeld `fact`). Unter 700 px Höhe und auf Tablets
             quer unter 900 px entfällt er: dort reicht die Höhe nicht für Ergebnis und Satz
             (gemessen, scripts/pruefen-bedienung.py). -->
        <p class="result__fact" id="result-fact"></p>
      </section>

      <!-- Der Balken trägt zwei Aussagen: die Füllung ist der Fortschritt, die Farbe die Gefahr.
           Die Zustandsklassen (`is-tense`, `is-danger`, `is-snapped`) sitzen an DIESEM Kasten, denn
           er enthält Balken, Zeile und Hinweis (docs/e2e-nachweise.md §5t). -->
      <div class="tension-panel" id="hud-panel">
        <div class="tension-meter" role="img" aria-label="Fortschritt der Runde und Bissgefahr des nächsten Drucks">
          <div class="tension-meter__fill" id="hud-meter"></div>
        </div>
        <div class="meter-legend">
          <span id="hud-progress">0 von 10 gedrückt</span>
          <span id="hud-tension">Bissgefahr 0 %</span>
        </div>
        <p class="meter-hint hidden" id="hud-meter-hint">
          Je mehr Zähne getippt sind, desto sicherer schnappt es zu.
        </p>
      </div>

      <p class="alarm hidden" id="hud-warning" role="status"></p>

      <!-- Nur vor dem ersten Druck: danach macht die Anleitung Hinweis und Warnung Platz. -->
      <p class="how-to" id="how-to">Tippe oder halte einen Zahn. Einer ist der falsche — dann schnappt es zu!</p>
      <p class="sr-only">Mit der Tastatur: mit der Tabulatortaste einen Zahn auswählen, dann die Eingabetaste drücken.</p>
    </div>

    <!--
      Die drei häufigen Griffe stehen auf der Spielseite (Entscheidung vom 12.10.2026; vorher
      hinter dem Zahnrad: 4 Tipps für ein anderes Tier, 3 für die Zahnzahl). Unter 640 px ist die
      Leiste am unteren Rand fest und die Köpfe öffnen sich als Blatt; ab 640 px stehen die Köpfe
      dauerhaft offen (`#creature-rail`) und der Tier-Griff entfällt.
      Die Kacheln tragen weder `.creature` noch `.tooth` — die Steuerung fragt diese Klassen ab.
    -->
    <aside class="side" aria-label="Spiel einstellen">
      <ul class="creature-grid creature-rail" id="creature-rail" role="group" aria-label="Lebewesen">
        {creatures.map((creature) => (
          <li>
            <button type="button" data-creature={creature.id} aria-pressed={creature.id === DEFAULT_CREATURE_ID}>
              <span class="creature-grid__icon" aria-hidden="true">
                <Fragment set:html={creaturePortrait(creature.id, 'leiste')} />
              </span>
              <span class="creature-grid__name">{creature.name}</span>
            </button>
          </li>
        ))}
      </ul>

      <div class="controls" id="controls">
        <button type="button" class="quick-pick" id="creature-open" aria-haspopup="dialog">
          <span class="quick-pick__icon" id="creature-icon" aria-hidden="true">
            {first && <Fragment set:html={creaturePortrait(first.id, 'wahl')} />}
          </span>
          <span class="quick__label">Tier</span>
          <span class="sr-only" id="creature-name">{first?.name}</span>
        </button>

        <div class="quick-teeth" role="group" aria-label="Zahl der Zähne">
          <button type="button" id="teeth-minus" aria-label="Ein Zahn weniger">−</button>
          <span class="quick-teeth__value">
            <output id="teeth-value">{first?.teeth}</output>
            <span class="quick__label" id="teeth-label">Zähne</span>
          </span>
          <button type="button" id="teeth-plus" aria-label="Ein Zahn mehr">+</button>
        </div>

        <button type="button" class="quick-new" id="new-round">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 12a8 8 0 1 1-2.6-5.9"></path>
            <path d="M20 4v5h-5"></path>
          </svg>
          <span>Neue Runde</span>
        </button>
      </div>
    </aside>
  </main>

  <dialog class="sheet sheet--columns" id="settings-sheet" aria-labelledby="settings-title">
    <!-- Der Kopf bleibt stehen: das ✕ ist der Ausgang, der immer erreichbar ist. -->
    <div class="sheet__head">
      <div class="sheet__grip" aria-hidden="true"></div>
      <div class="sheet__headrow">
        <h2 id="settings-title">Einstellungen</h2>
        <button type="button" class="sheet__close" data-close-sheet aria-label="Einstellungen schließen">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Nur was je Sitzung gestellt wird. Tier, Zähne und „Neue Runde" stehen auf der Spielseite. -->
    <div class="set">
      <span class="set__label">Wie viele spielen?</span>
      <div class="segmented" id="opt-players" role="group" aria-label="Spielerzahl">
        <button type="button" data-players="1" aria-pressed="true">Allein</button>
        <button type="button" data-players="2" aria-pressed="false">Zu zweit</button>
      </div>
    </div>

    <div class="set">
      <span class="set__label">Wie gefährlich?</span>
      <div class="segmented" id="opt-mode" role="group" aria-label="Zufallsmodell">
        <button type="button" data-mode="original" aria-pressed="true">wie das Spielzeug</button>
        <button type="button" data-mode="classic" aria-pressed="false">nur ein Zahn</button>
      </div>
    </div>

    <div class="switches">
      <label class="switch"><input type="checkbox" id="opt-sound" checked /> Ton</label>
      <label class="switch"><input type="checkbox" id="opt-vibration" checked /> Wackeln</label>
    </div>
    <p class="muted small" id="vibration-hint" hidden></p>

    <div class="row sheet__actions">
      <button type="button" class="button--ghost" id="rules-open">Regeln</button>
      <a class="button button--ghost" href={`${base}statistik`}>Statistik</a>
      <!-- Der Weg zurück zum Spiel. Ohne ihn blieb nur die Escape-Taste — die hat kein Tablet. -->
      <button type="button" class="button--primary" data-close-sheet>Fertig</button>
    </div>
  </dialog>

  <dialog class="sheet" id="creature-sheet" aria-labelledby="creature-title">
    <div class="sheet__grip" aria-hidden="true"></div>
    <h2 id="creature-title">Welches Tier?</h2>
    <ul class="creature-grid" id="creature-list" role="group" aria-label="Lebewesen">
      {creatures.map((creature) => (
        <li>
          <button type="button" data-creature={creature.id} aria-pressed={creature.id === DEFAULT_CREATURE_ID}>
            <span class="creature-grid__icon" aria-hidden="true">
              <Fragment set:html={creaturePortrait(creature.id, 'kachel')} />
            </span>
            <span class="creature-grid__name">{creature.name}</span>
          </button>
        </li>
      ))}
    </ul>
    <div class="sheet__actions">
      <button type="button" class="button--primary" data-close-sheet>Fertig</button>
    </div>
  </dialog>

  <dialog class="sheet" id="rules-sheet" aria-labelledby="rules-title">
    <div class="sheet__grip" aria-hidden="true"></div>
    <h2 id="rules-title">Regeln</h2>
    <p>
      Jede Person tippt nacheinander einen Zahn an. Wer den falschen erwischt, lässt das Maul
      zuschnappen — und hat verloren.
    </p>
    <p>
      Du kannst einen Zahn auch gedrückt halten: entschieden wird erst, wenn du loslässt. Wer sich
      nicht traut, schiebt den Finger vom Zahn — dann zählt der Druck nicht.
    </p>
    <p>
      Welcher Zahn der falsche ist, weiß man vorher nicht. Nur eines ist sicher: Ist nur noch ein
      Zahn übrig, ist er es.
    </p>
    <div class="creature-detail">
      <p id="creature-detail-line"></p>
      <p class="muted small" id="creature-detail-note"></p>
      <p class="muted small" id="creature-detail-real"></p>
    </div>
    <div class="album-rules">
      <p>
        <strong>Sterne sammeln:</strong> Jedes Tier kann drei Sterne bekommen —
        ★ <strong>gespielt</strong>, ★★ <strong>halb geschafft</strong> (die Hälfte der Zähne war
        harmlos) und ★★★ <strong>bis zum letzten Zahn</strong>. Für den zweiten und dritten Stern
        braucht das Tier alle seine Zähne. Sterne sind Glück: welcher Zahn zuschnappt, weiß niemand.
      </p>
      <p class="muted small album-summary"></p>
    </div>
    <details>
      <summary>Für Große: warum es keinen sicheren Zahn gibt</summary>
      <p>
        Beim Original dreht beim Öffnen ein Nockenrad einen bumerangförmigen Hebel, der mit
        <strong>1 bis 3 Zähnen gleichzeitig</strong> in Kontakt steht (make Magazin 1/2023, Teardown).
        Die Trefferchance pro Druck ist damit 10 %, 20 % oder 30 % — unbekannt zu Rundenbeginn. Genau
        so rechnet diese App im Modus „wie das Spielzeug“.
      </p>
      <p>
        <strong>Rechenwerte (10 Zähne, zufällige Reihenfolge):</strong> P(Biss beim 1. Druck) = 20 %,
        erwartete Drücke bis zum Biss = 3,97. Wer bis zum letzten Zahn überlebt, verliert garantiert.
      </p>
      <p>
        <strong>Warum mehrere Lebewesen:</strong> Jedes Tier hat sein eigenes Gebiss. Krokodil und
        Mensch stellen <strong>1–3 Zähne gleichzeitig scharf</strong>, alle anderen nur
        <strong>1–2</strong>: ihr Biss kommt seltener, dann sitzt er (erwartete Drücke bei 12 Zähnen
        5,42 statt 4,69). Die Maus hat nur <strong>sechs</strong> Zähne — die kürzeste Runde. Welcher
        Zahn scharf ist, entscheidet bei jedem Tier allein der Zufall: lange Fang- und Eckzähne sind
        nicht öfter scharf als die anderen.
      </p>
      <p>
        <strong>Was der Balken zeigt:</strong> Er trägt zwei Aussagen. Die <strong>Füllung</strong> ist
        der Fortschritt — wie viele Zähne schon gedrückt sind. Die <strong>Farbe</strong> ist die
        Gefahr: die Wahrscheinlichkeit, dass der nächste Druck das Maul zuschnappen lässt (im Spiel
        steht sie als Zahl dabei). Sie wächst mit jedem Druck, wird spät gold und vor dem letzten Zahn
        rot — der letzte Zahn ist garantiert scharf. Der Balken pulsiert, und je höher die Gefahr,
        desto schneller. Und er hat einen Zweck: die Gefahr, die du überstehst, ist dein
        <strong>Mut</strong> — am Ende der Runde steht im Ergebnis, bei wie viel Prozent Bissgefahr
        dein mutigster Druck noch harmlos blieb.
      </p>
    </details>
    <p class="muted small">
      Diese App ist ein eigenständiges Spiel, kein Produkt von Hasbro. Die Statistikseite wertet eure
      eigenen Runden aus und sagt ehrlich, wenn die Daten für eine Aussage zu dünn sind.
    </p>
    <div class="sheet__actions">
      <button type="button" class="button--primary" data-close-sheet>Verstanden</button>
    </div>
  </dialog>

  <script>
    import { GameController } from '../presentation/game/gameController';
    import { wireAlbum } from '../presentation/game/albumBadges';
    import { creaturePortrait } from '../presentation/game/creatures';
    import { wireQuickControls } from '../presentation/game/quickControls';
    import { closeSheet, openSheet as showSheet, wireOutsideTapDismissal } from '../presentation/game/sheets';
    import { CryptoRandom } from '../infrastructure/random/cryptoRandom';
    import { WebAudioEngine } from '../infrastructure/audio/webAudioEngine';
    import { BrowserHaptics } from '../infrastructure/haptics/browserHaptics';
    import { LocalStorageRoundLog, STORAGE_KEY, browserStorage } from '../infrastructure/storage/localStorageLog';
    import { requestPersistence } from '../infrastructure/storage/browserPersistence';
    import { HttpRemoteLog, backupCode, backupUrl } from '../infrastructure/storage/httpRemoteLog';
    import { wireBackup } from '../presentation/game/backupSync';
    import { browserSessionMarks } from '../infrastructure/storage/sessionStorageMarks';
    import { loadSettings, saveSettings, type GameSettings } from '../infrastructure/storage/localStorageSettings';

    const storage = browserStorage();
    const settings = loadSettings(storage);
    // Die Tierstimmen sind Dateien unter dem Basis-Pfad der Seite (public/sounds/voices/).
    const sound = new WebAudioEngine({ muted: !settings.sound, voiceBaseUrl: import.meta.env.BASE_URL });
    const haptics = new BrowserHaptics();
    const log = new LocalStorageRoundLog(storage);
    // Runden und Sterne sollen bleiben: ohne diese Bitte darf der Browser die Ablage bei knappem
    // Platz leeren. Was er geantwortet hat, zeigt die Statistikseite.
    void requestPersistence();

    const controller = new GameController({
      rng: new CryptoRandom(),
      sound,
      haptics,
      log,
      settings,
      session: browserSessionMarks(),
      document,
      onSettingsChange: (next: GameSettings) => saveSettings(storage, next),
    });

    controller.mount();

    // Das Tier-Album: Sterne an den Kacheln, abgeleitet aus derselben Ablage. Es hört selbst auf
    // `kroko:round-finished`; was von außen kommt (anderer Tab, Zurück-Taste), zieht `paint()` nach.
    const album = wireAlbum({ doc: document, log });

    // Das Protokoll kann sich außerhalb dieser Seite ändern: die Statistikseite löscht oder
    // importiert in einem anderen Tab (`storage`), oder diese Seite kommt über die Zurück-Taste
    // unverändert aus dem Zwischenspeicher des Browsers (`pageshow` mit `persisted`).
    window.addEventListener('storage', (event) => {
      if (event.key === null || event.key === STORAGE_KEY) {
        controller.syncLog();
        album.paint();
      }
    });
    window.addEventListener('pageshow', (event) => {
      if (event.persisted) {
        controller.syncLog();
        album.paint();
      }
    });

    // Sicherung außerhalb des Geräts — nur, wenn die Adresse einen Sicherungscode trägt
    // (`…/s/<code>` oder `?s=<code>`).
    // Ein Profil, das seine Browserdaten verwirft, bekommt so beim Start seine Runden zurück;
    // nach jedem Biss wird nachgesichert. Ohne Code geschieht hier nichts.
    const code = backupCode(location.search, storage, location.pathname);
    if (code) {
      const backup = wireBackup({
        local: log,
        remote: new HttpRemoteLog(backupUrl(import.meta.env.BASE_URL, code)),
        onLocalChange: () => {
          controller.syncLog();
          album.paint();
        },
      });
      void backup.sync();
      document.addEventListener('kroko:round-finished', () => void backup.sync());
    }

    /** Blätter öffnen und schließen. */
    const sheetOf = (id: string): HTMLDialogElement | null =>
      document.getElementById(id) as HTMLDialogElement | null;
    const openSheet = (id: string): void => showSheet(sheetOf(id));

    // Schalter und Segmente mit den gespeicherten Einstellungen abgleichen
    const soundBox = document.getElementById('opt-sound') as HTMLInputElement | null;
    const vibrationBox = document.getElementById('opt-vibration') as HTMLInputElement | null;
    if (soundBox) soundBox.checked = settings.sound;
    if (vibrationBox) vibrationBox.checked = settings.vibration;
    // Ehrlich statt still: kann der Browser nicht vibrieren (Safari auf iOS), sagen wir es und
    // schalten den Griff ab — sonst sucht man den Fehler beim Handy oder im Spiel.
    const vibrationHint = document.getElementById('vibration-hint');
    if (vibrationBox && !haptics.isSupported()) {
      vibrationBox.checked = false;
      vibrationBox.disabled = true;
      if (vibrationHint) {
        vibrationHint.hidden = false;
        vibrationHint.textContent = 'Dieser Browser kann nicht wackeln (z. B. Safari auf dem iPhone).';
      }
    }
    document.querySelectorAll<HTMLButtonElement>('#opt-players [data-players]').forEach((button) => {
      button.setAttribute('aria-pressed', String(Number(button.dataset.players) === settings.players));
      button.addEventListener('click', () => {
        document.querySelectorAll('#opt-players [data-players]').forEach((other) => other.setAttribute('aria-pressed', 'false'));
        button.setAttribute('aria-pressed', 'true');
        controller.applySettings({ ...settings, players: Number(button.dataset.players ?? '1') });
      });
    });
    document.querySelectorAll<HTMLButtonElement>('#opt-mode [data-mode]').forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.mode === settings.mode));
      button.addEventListener('click', () => {
        document.querySelectorAll('#opt-mode [data-mode]').forEach((other) => other.setAttribute('aria-pressed', 'false'));
        button.setAttribute('aria-pressed', 'true');
        controller.applySettings({ ...settings, mode: button.dataset.mode === 'classic' ? 'classic' : 'original' });
      });
    });
    soundBox?.addEventListener('change', () => controller.applySettings({ ...settings, sound: soundBox.checked }));
    vibrationBox?.addEventListener('change', () => controller.applySettings({ ...settings, vibration: vibrationBox.checked }));

    // Die Leiste der Spielseite (Tier, Zähne): Regeln und Test stehen in quickControls.ts.
    // Ein Tipp auf eine Kachel wählt und schließt das Auswahlblatt — auf dem Tablet ist es gar
    // nicht offen, `closeSheet` tut dann nichts.
    wireQuickControls({
      doc: document,
      settings,
      apply: (next: GameSettings) => controller.applySettings(next),
      portrait: creaturePortrait,
      onCreatureChosen: () => {
        const sheet = sheetOf('creature-sheet');
        if (sheet?.hasAttribute('open')) closeSheet(sheet);
      },
    });

    document.getElementById('settings-open')?.addEventListener('click', () => openSheet('settings-sheet'));
    document.getElementById('creature-open')?.addEventListener('click', () => openSheet('creature-sheet'));

    document.getElementById('rules-open')?.addEventListener('click', () => openSheet('rules-sheet'));
    document.querySelectorAll('[data-close-sheet]').forEach((button) => {
      button.addEventListener('click', () => closeSheet(button.closest('dialog')));
    });

    // Ein Tipp neben das oberste Blatt schließt es — die Regeln stehen (geprüft) in sheets.ts.
    wireOutsideTapDismissal(document);

    // Browser geben Ton erst nach einer Nutzergeste frei. `pointerup` statt `pointerdown`: ein
    // Finger, der nur scrollt, endet mit `pointercancel` und ist keine Freigabe — die Engine
    // hielte sich sonst für freigegeben, während der Browser den Ton noch sperrt. Bei **jeder**
    // Geste, nicht nur der ersten: die erste kann eine sein, die der Browser nicht zählt, und iOS
    // hält den Ton nach einem Anruf wieder an (`unlock()` tut nichts, solange er läuft).
    document.addEventListener('pointerup', () => sound.unlock());
    document.addEventListener('keydown', () => sound.unlock());
  </script>
</Base>
