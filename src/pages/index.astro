---
import Base from '../layouts/Base.astro';
import { DEFAULT_CREATURE_ID, listCreatures } from '../core/domain/creature';
import { creaturePortrait } from '../presentation/game/creatures';

const creatures = listCreatures();
const first = creatures.find((creature) => creature.id === DEFAULT_CREATURE_ID) ?? creatures[0];
const base = import.meta.env.BASE_URL;
---

<Base
  title="Zahn Agent — Zahn für Zahn zum Nervenkitzel"
  description="Tippe die Zähne des Krokodils an. Ein Druck ist zu viel — dann schnappt das Maul zu. Mit Statistik, wer wirklich verliert."
>
  <!--
    Das Spiel kommt zuerst: Tier und Spielstand. Alles Einstellbare liegt hinter dem Zahnrad,
    damit ein Kind beim Öffnen nichts scrollen muss und nichts ablenkt. Die zwei benannten
    Anzeigewerte (Fortschritt und Bissgefahr) bleiben wörtlich stehen — sie tragen die
    Ehrlichkeitsregel.
  -->
  <main class="app">
    <header class="topbar">
      <div class="brand">
        <svg viewBox="0 0 64 64" aria-hidden="true">
          <path d="M4 30c8-8 22-10 34-7l16 5-16 5C26 37 12 36 4 30z" fill="#2f6b4f"></path>
          <path d="M6 40c12-5 24-5 36-2l14 4-14 4C30 48 16 47 6 40z" fill="#1c4531"></path>
          <path d="M18 34l4 9 4-9zM32 33l4 9 4-9zM46 34l4 8 4-9z" fill="#fbf7e8"></path>
          <circle cx="46" cy="22" r="5.5" fill="#f7f4e6"></circle>
          <circle cx="47" cy="23" r="2.4" fill="#10171b"></circle>
        </svg>
        <span>Zahn Agent</span>
      </div>
      <button type="button" class="icon-button" id="settings-open" aria-haspopup="dialog" aria-label="Einstellungen öffnen">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6"></path>
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1"></path>
        </svg>
      </button>
    </header>

    <section class="stage" id="stage" data-status="open" aria-label="Spielbühne">
      <div id="croc-mount"></div>
    </section>

    <!-- Eine große Aussage, der Rest ist ruhige Nebenzeile. -->
    <section class="hud" aria-label="Spielstand">
      <div class="stat stat--big">
        <span class="stat__value" id="hud-remaining">10</span>
        <span class="stat__label" id="hud-remaining-label">Zähne übrig</span>
      </div>
      <div class="stat stat--quiet">
        <span>Runde <strong id="hud-round">1</strong></span>
        <span>schon <strong id="hud-presses">0</strong> getippt</span>
      </div>
    </section>

    <div class="turn">
      <span class="turn__dot" aria-hidden="true"></span>
      <span id="hud-turn">Du bist dran</span>
    </div>

    <!-- Der Balken trägt zwei Aussagen: die Füllung ist der Fortschritt, die Farbe die Gefahr. -->
    <div class="tension-meter" role="img" aria-label="Fortschritt der Runde und Bissgefahr des nächsten Drucks">
      <div class="tension-meter__fill" id="hud-meter"></div>
    </div>
    <div class="meter-legend">
      <span id="hud-progress">0 von 10 gedrückt</span>
      <span id="hud-tension">Bissgefahr 0 %</span>
    </div>

    <p class="meter-hint hidden" id="hud-meter-hint">
      Je mehr Zähne getippt sind, desto sicherer schnappt es zu.
    </p>

    <p class="alarm hidden" id="hud-warning" role="status"></p>

    <p class="how-to">Tippe einen Zahn an. Einer ist der falsche — dann schnappt es zu!</p>
    <p class="sr-only">Mit der Tastatur: mit der Tabulatortaste einen Zahn auswählen, dann die Eingabetaste drücken.</p>
  </main>

  <dialog class="sheet sheet--columns" id="settings-sheet" aria-labelledby="settings-title">
    <!-- Der Kopf bleibt beim Scrollen stehen: das ✕ ist der Ausgang, der immer erreichbar ist. -->
    <div class="sheet__head">
      <div class="sheet__grip" aria-hidden="true"></div>
      <div class="sheet__headrow">
        <h2 id="settings-title">Einstellungen</h2>
        <button type="button" class="sheet__close" data-close-sheet aria-label="Einstellungen schließen">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18"></path>
          </svg>
        </button>
      </div>
    </div>

    <div class="set">
      <span class="set__label">Wie viele spielen?</span>
      <div class="segmented" id="opt-players" role="group" aria-label="Spielerzahl">
        <button type="button" data-players="1" aria-pressed="true">1</button>
        <button type="button" data-players="2" aria-pressed="false">2</button>
        <button type="button" data-players="3" aria-pressed="false">3</button>
        <button type="button" data-players="4" aria-pressed="false">4</button>
      </div>
    </div>

    <div class="set">
      <span class="set__label">Welches Tier?</span>
      <button type="button" class="picker" id="creature-open" aria-haspopup="dialog">
        <span class="picker__icon" id="creature-icon" aria-hidden="true">
          {first && <Fragment set:html={creaturePortrait(first.id, 'wahl')} />}
        </span>
        <span class="picker__text">
          <span class="picker__name" id="creature-name">{first?.name}</span>
          <span class="muted small" id="creature-teeth">{first?.teeth} Zähne</span>
        </span>
      </button>
    </div>

    <div class="set">
      <span class="set__label">Wie viele Zähne?</span>
      <div class="row">
        <div class="stepper">
          <button type="button" id="teeth-minus" aria-label="Ein Zahn weniger">−</button>
          <output id="teeth-value">{first?.teeth}</output>
          <button type="button" id="teeth-plus" aria-label="Ein Zahn mehr">+</button>
        </div>
        <button type="button" class="button--ghost button--small" id="teeth-reset">Standard</button>
      </div>
      <p class="muted small" id="teeth-hint"></p>
    </div>

    <div class="set">
      <span class="set__label">Wie gefährlich?</span>
      <div class="segmented" id="opt-mode" role="group" aria-label="Zufallsmodell">
        <button type="button" data-mode="original" aria-pressed="true">wie das Spielzeug</button>
        <button type="button" data-mode="classic" aria-pressed="false">nur ein Zahn</button>
      </div>
      <!-- Die Erklärung („1 bis 3 Zähne gleichzeitig, 10/20/30 %") steht ausführlich im
           Regeln-Blatt unter „Für Große" — hier wäre sie nur eine zweite, längere Fassung. -->
    </div>

    <label class="switch"><input type="checkbox" id="opt-sound" checked /> Ton an</label>
    <label class="switch"><input type="checkbox" id="opt-vibration" checked /> Wackeln (Handy)</label>
    <p class="muted small" id="vibration-hint" hidden></p>

    <div class="row sheet__actions">
      <button type="button" class="button--primary" id="new-round">Neue Runde</button>
      <button type="button" class="button--ghost" id="rules-open">Regeln</button>
    </div>

    <a class="button sheet-link" href={`${base}statistik`}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M4 20V10M10 20V4M16 20v-7M22 20H2"></path>
      </svg>
      Statistik für Große
    </a>
    <!-- Der Weg zurück zum Spiel. Ohne ihn blieb nur die Escape-Taste — die hat kein Tablet. -->
    <button type="button" class="button button--primary sheet-link" data-close-sheet>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M20 6L9 17l-5-5"></path>
      </svg>
      Fertig
    </button>
  </dialog>

  <dialog class="sheet" id="creature-sheet" aria-labelledby="creature-title">
    <div class="sheet__grip" aria-hidden="true"></div>
    <h2 id="creature-title">Welches Tier?</h2>
    <ul class="creature-grid" id="creature-list" role="group" aria-label="Lebewesen">
      {creatures.map((creature) => (
        <li>
          <button type="button" data-creature={creature.id} aria-pressed={creature.id === DEFAULT_CREATURE_ID}>
            <span class="creature-grid__icon" aria-hidden="true">
              <Fragment set:html={creaturePortrait(creature.id, 'kachel')} />
            </span>
            <span class="creature-grid__name">{creature.name}</span>
          </button>
        </li>
      ))}
    </ul>
    <div class="creature-detail">
      <p id="creature-detail-line"></p>
      <details>
        <summary>Mehr über dieses Tier</summary>
        <p class="muted small" id="creature-detail-note"></p>
        <p class="muted small" id="creature-detail-real"></p>
      </details>
    </div>
    <div class="sheet__actions">
      <button type="button" class="button--primary" id="creature-apply">Damit spielen</button>
      <button type="button" class="button--ghost" data-close-sheet>Abbrechen</button>
    </div>
  </dialog>

  <dialog class="sheet" id="rules-sheet" aria-labelledby="rules-title">
    <div class="sheet__grip" aria-hidden="true"></div>
    <h2 id="rules-title">Regeln</h2>
    <p>
      Jede Person tippt nacheinander einen Zahn an. Wer den falschen erwischt, lässt das Maul
      zuschnappen — und hat verloren.
    </p>
    <p>
      Welcher Zahn der falsche ist, weiß man vorher nicht. Nur eines ist sicher: Ist nur noch ein
      Zahn übrig, ist er es.
    </p>
    <details>
      <summary>Für Große: warum es keinen sicheren Zahn gibt</summary>
      <p>
        Beim Original dreht beim Öffnen ein Nockenrad einen bumerangförmigen Hebel, der mit
        <strong>1 bis 3 Zähnen gleichzeitig</strong> in Kontakt steht (make Magazin 1/2023, Teardown).
        Die Trefferchance pro Druck ist damit 10 %, 20 % oder 30 % — unbekannt zu Rundenbeginn. Genau
        so rechnet diese App im Modus „wie das Spielzeug“.
      </p>
      <p>
        <strong>Rechenwerte (10 Zähne, zufällige Reihenfolge):</strong> P(Biss beim 1. Druck) = 20 %,
        erwartete Drücke bis zum Biss = 3,97; bei 4 Spielern verliert der Startspieler zu 33,9 %,
        danach 28,3 % / 20,7 % / 17,0 %. Wer bis zum letzten Zahn überlebt, verliert garantiert.
      </p>
      <p>
        <strong>Warum mehrere Lebewesen:</strong> Krokodil, Wolf, Mensch, Hai, Maus und Vampir haben
        unterschiedliche Gebisse. Der Wolf hat zwei große Fangzähne, dafür nur <strong>1–2
        gleichzeitig scharfe Zähne</strong>: sein Biss kommt seltener, dann sitzt er (erwartete
        Drücke bei 12 Zähnen 5,42 statt 4,69). Der Hai hat dieselbe 1–2-Regel mit runden
        Raubtierzähnen, die Maus nur <strong>sechs</strong> Nagezähne (die kürzeste Runde) und der
        Vampir zwei lange Eckzähne. Jedes weitere Tier ist ein Katalog-Eintrag plus eine Zeichnung.
      </p>
      <p>
        <strong>Was der Balken zeigt:</strong> Er trägt zwei Aussagen. Die <strong>Füllung</strong> ist
        der Fortschritt — wie viele Zähne schon gedrückt sind. Die <strong>Farbe</strong> ist die
        Gefahr: die Wahrscheinlichkeit, dass der nächste Druck das Maul zuschnappen lässt (im Spiel
        steht sie als Zahl dabei). Sie wächst mit jedem Druck, wird spät gold und vor dem letzten Zahn
        rot — der letzte Zahn ist garantiert scharf. Der Balken atmet im Takt des Herzschlags. Und er
        hat einen Zweck: die Gefahr, die du überstehst, ist dein <strong>Mut</strong> — am Ende der
        Runde steht im Ergebnis, bei wie viel Prozent Bissgefahr dein mutigster Druck noch harmlos
        blieb.
      </p>
    </details>
    <p class="muted small">
      Diese App ist ein eigenständiges Spiel, kein Produkt von Hasbro. Die Statistikseite wertet eure
      eigenen Runden aus und sagt ehrlich, wenn die Daten für eine Aussage zu dünn sind.
    </p>
    <div class="sheet__actions">
      <button type="button" class="button--primary" data-close-sheet>Verstanden</button>
    </div>
  </dialog>

  <dialog class="sheet" id="result-sheet" aria-labelledby="result-title">
    <div class="sheet__grip" aria-hidden="true"></div>
    <h2 id="result-title">Zugeschnappt!</h2>
    <p id="result-text"></p>
    <div class="sheet__actions">
      <button type="button" class="button--primary" id="result-again">Noch eine Runde</button>
      <a class="button" href={`${base}statistik`}>Zur Statistik</a>
      <button type="button" class="button--ghost" data-close-sheet>Schließen</button>
    </div>
  </dialog>

  <script>
    import { GameController } from '../presentation/game/gameController';
    import { creaturePortrait } from '../presentation/game/creatures';
    import { CryptoRandom } from '../infrastructure/random/cryptoRandom';
    import { WebAudioEngine } from '../infrastructure/audio/webAudioEngine';
    import { BrowserHaptics } from '../infrastructure/haptics/browserHaptics';
    import { LocalStorageRoundLog, browserStorage } from '../infrastructure/storage/localStorageLog';
    import { browserSessionMarks } from '../infrastructure/storage/sessionStorageMarks';
    import { loadSettings, saveSettings, type GameSettings } from '../infrastructure/storage/localStorageSettings';
    import { getCreature } from '../core/domain/creature';
    import { MAX_TEETH, MIN_TEETH } from '../core/domain/teeth';

    const storage = browserStorage();
    const settings = loadSettings(storage);
    const sound = new WebAudioEngine({ muted: !settings.sound });
    const haptics = new BrowserHaptics();
    const log = new LocalStorageRoundLog(storage);

    const controller = new GameController({
      rng: new CryptoRandom(),
      sound,
      haptics,
      log,
      settings,
      session: browserSessionMarks(),
      document,
      onSettingsChange: (next: GameSettings) => saveSettings(storage, next),
    });

    controller.mount();

    /** Blätter öffnen und schließen. */
    const sheetOf = (id: string): HTMLDialogElement | null =>
      document.getElementById(id) as HTMLDialogElement | null;
    const openSheet = (id: string): void => {
      const sheet = sheetOf(id);
      if (sheet && typeof sheet.showModal === 'function') {
        sheet.showModal();
      } else {
        sheet?.setAttribute('open', '');
      }
    };

    // Schalter und Segmente mit den gespeicherten Einstellungen abgleichen
    const soundBox = document.getElementById('opt-sound') as HTMLInputElement | null;
    const vibrationBox = document.getElementById('opt-vibration') as HTMLInputElement | null;
    if (soundBox) soundBox.checked = settings.sound;
    if (vibrationBox) vibrationBox.checked = settings.vibration;
    // Ehrlich statt still: kann der Browser nicht vibrieren (Safari auf iOS), sagen wir es und
    // schalten den Griff ab — sonst sucht man den Fehler beim Handy oder im Spiel.
    const vibrationHint = document.getElementById('vibration-hint');
    if (vibrationBox && !haptics.isSupported()) {
      vibrationBox.checked = false;
      vibrationBox.disabled = true;
      if (vibrationHint) {
        vibrationHint.hidden = false;
        vibrationHint.textContent =
          'Dieser Browser kann nicht wackeln (z. B. Safari auf dem iPhone — dort fehlt die Schnittstelle). Ton und Spiel bleiben.';
      }
    }
    document.querySelectorAll<HTMLButtonElement>('#opt-players [data-players]').forEach((button) => {
      button.setAttribute('aria-pressed', String(Number(button.dataset.players) === settings.players));
      button.addEventListener('click', () => {
        document.querySelectorAll('#opt-players [data-players]').forEach((other) => other.setAttribute('aria-pressed', 'false'));
        button.setAttribute('aria-pressed', 'true');
        controller.applySettings({ ...settings, players: Number(button.dataset.players ?? '1') });
      });
    });
    document.querySelectorAll<HTMLButtonElement>('#opt-mode [data-mode]').forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.mode === settings.mode));
      button.addEventListener('click', () => {
        document.querySelectorAll('#opt-mode [data-mode]').forEach((other) => other.setAttribute('aria-pressed', 'false'));
        button.setAttribute('aria-pressed', 'true');
        controller.applySettings({ ...settings, mode: button.dataset.mode === 'classic' ? 'classic' : 'original' });
      });
    });
    soundBox?.addEventListener('change', () => controller.applySettings({ ...settings, sound: soundBox.checked }));
    vibrationBox?.addEventListener('change', () => controller.applySettings({ ...settings, vibration: vibrationBox.checked }));

    const creatureName = document.getElementById('creature-name');
    const creatureTeeth = document.getElementById('creature-teeth');
    const creatureIcon = document.getElementById('creature-icon');
    const teethValue = document.getElementById('teeth-value');
    const teethHint = document.getElementById('teeth-hint');
    const detailLine = document.getElementById('creature-detail-line');
    const detailNote = document.getElementById('creature-detail-note');
    const detailReal = document.getElementById('creature-detail-real');

    /** Zahnzahl, die gerade gilt: eigener Wert oder das tiergerechte Gebiss. */
    function effectiveTeeth(): number {
      return settings.teethOverride ?? getCreature(settings.creature).teeth;
    }

    /** Das Einstellungsblatt: gewähltes Tier, Zahnzahl, Zahnrad-Vorschau. */
    function paintCreature(): void {
      const creature = getCreature(settings.creature);
      const teeth = effectiveTeeth();
      if (creatureName) creatureName.textContent = creature.name;
      if (creatureTeeth) creatureTeeth.textContent = teeth === 1 ? '1 Zahn' : `${teeth} Zähne`;
      if (creatureIcon) creatureIcon.innerHTML = creaturePortrait(creature.id, 'wahl');
      if (teethValue) teethValue.textContent = String(teeth);
      if (teethHint) {
        if (teeth === 1) {
          // Wunsch vom 11.10.2026: ein einziges Gebiss — der Tipp darauf schließt das Maul.
          // Bei einem Zahn sind beide Zufallsmodelle ohnehin gleich, deshalb steht hier kein Modus.
          teethHint.textContent = 'nur ein Zahn — der erste Tipp schließt das Maul';
        } else if (settings.teethOverride === null) {
          teethHint.textContent = `Standard für ${creature.name}`;
        } else {
          teethHint.textContent = `abweichend (Standard ${creature.teeth}), spielbar ${MIN_TEETH}–${MAX_TEETH}`;
        }
      }
    }

    /**
     * Das Auswahlblatt: Die Wahl im Blatt ist zunächst nur eine **Vorschau** (`pending`) — erst
     * „Damit spielen“ übernimmt sie. Sonst schlösse jeder Tipp das Blatt, und die Kurzinfo zum Tier
     * wäre nie zu lesen.
     */
    let pending = settings.creature;

    function paintChoice(): void {
      const creature = getCreature(pending);
      document.querySelectorAll<HTMLButtonElement>('#creature-list [data-creature]').forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.creature === pending));
      });
      if (detailLine) {
        const live = creature.liveTeethMin === creature.liveTeethMax
          ? `${creature.liveTeethMin}`
          : `${creature.liveTeethMin}–${creature.liveTeethMax}`;
        detailLine.textContent = `${creature.teeth} Zähne — bei jedem Tipp sind ${live} davon gefährlich.`;
      }
      if (detailNote) detailNote.textContent = creature.note;
      if (detailReal) detailReal.textContent = `Echtes Gebiss: ${creature.realTeeth} Zähne.`;
    }

    function setTeeth(next: number): void {
      const clamped = Math.max(MIN_TEETH, Math.min(MAX_TEETH, next));
      const standard = getCreature(settings.creature).teeth;
      controller.applySettings({ ...settings, teethOverride: clamped === standard ? null : clamped });
      paintCreature();
    }

    paintCreature();
    document.getElementById('settings-open')?.addEventListener('click', () => openSheet('settings-sheet'));
    document.getElementById('teeth-minus')?.addEventListener('click', () => setTeeth(effectiveTeeth() - 1));
    document.getElementById('teeth-plus')?.addEventListener('click', () => setTeeth(effectiveTeeth() + 1));
    document.getElementById('teeth-reset')?.addEventListener('click', () => {
      controller.applySettings({ ...settings, teethOverride: null });
      paintCreature();
    });
    document.getElementById('creature-open')?.addEventListener('click', () => {
      pending = settings.creature;
      paintChoice();
      openSheet('creature-sheet');
    });
    document.querySelectorAll<HTMLButtonElement>('#creature-list [data-creature]').forEach((button) => {
      button.addEventListener('click', () => {
        pending = button.dataset.creature ?? pending;
        paintChoice();
      });
    });
    document.getElementById('creature-apply')?.addEventListener('click', () => {
      // Beim Wechsel gilt wieder das Gebiss des gewählten Tieres.
      controller.applySettings({ ...settings, creature: pending, teethOverride: null });
      paintCreature();
      sheetOf('creature-sheet')?.close();
    });

    document.getElementById('result-again')?.addEventListener('click', () => controller.resetRound());
    document.getElementById('rules-open')?.addEventListener('click', () => openSheet('rules-sheet'));
    document.querySelectorAll('[data-close-sheet]').forEach((button) => {
      button.addEventListener('click', () => {
        button.closest('dialog')?.close();
      });
    });

    /**
     * Ein Tipp **neben** das Blatt schließt es (zurück zum Spiel). Geprüft wird die Geometrie, nicht
     * das Zielelement: `event.target` ist bei einem Dialog auch der Innenabstand, so schlösse ein
     * Tipp daneben im Blatt selbst. Ohne das bliebe für den Rückweg nur die Escape-Taste.
     */
    document.querySelectorAll<HTMLDialogElement>('dialog.sheet').forEach((sheet) => {
      sheet.addEventListener('click', (event) => {
        const box = sheet.getBoundingClientRect();
        const daneben =
          event.clientX < box.left ||
          event.clientX > box.right ||
          event.clientY < box.top ||
          event.clientY > box.bottom;
        if (daneben) {
          sheet.close();
        }
      });
    });

    // Browser geben Ton erst nach einer Nutzergeste frei.
    document.addEventListener('pointerdown', () => sound.unlock(), { once: true });
    document.addEventListener('keydown', () => sound.unlock(), { once: true });
  </script>
</Base>
